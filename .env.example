# =====================================================================
#  AI-Based News Aggregator & Summarizer — environment configuration
#  Copy to .env and fill in what you need:   cp .env.example .env
#  Everything works without any keys (offline fallbacks); keys unlock more.
# =====================================================================

# ---------- Application ----------
ENVIRONMENT=development
DEBUG=False
LOG_LEVEL=INFO
# json = structured logs for Loki/ELK/CloudWatch, text = human-friendly
LOG_FORMAT=json

# ---------- AI (Groq LLM) ----------
# Free key: https://console.groq.com/keys  — enables LLM summaries, RAG chat, Perspective Lens analysis,
# AI Daily Briefing, translation and the plain-English explainer.
GROQ_API_KEY=
# Optional comma-separated model fallback chain (first = preferred)
GROQ_MODELS=

# ---------- Optional news APIs (in addition to RSS) ----------
NEWSAPI_KEY=
GNEWS_API_KEY=
NEWS_API_COUNTRY=in
# Add feeds without code changes:  Name|URL|Category;Name2|URL2|Category2
EXTRA_RSS_FEEDS=
# Comma-separated source names to switch off, e.g. "Times of India,Al Jazeera"
DISABLED_RSS_FEEDS=

# ---------- Collector ----------
COLLECTION_INTERVAL_SECONDS=300
FEED_FETCH_TIMEOUT_SECONDS=15
MAX_ARTICLES_PER_FEED=25
# auto  = load clearly-labelled offline demo stories only if no feed is reachable on first start
# true  = always add demo stories   |   false = never
SEED_DEMO_DATA=auto

# ---------- AI worker ----------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=10
WORKER_MAX_RETRIES=3
WORKER_LEASE_TIMEOUT_SECONDS=300

# ---------- Embeddings ----------
# fastembed (BAAI/bge-small-en-v1.5, downloaded on first start) or fallback (offline lexical hashing)
EMBEDDING_BACKEND=fastembed

# ---------- Database ----------
# Local PostgreSQL container is used by default. To use Supabase instead, set SUPABASE_DB_URL:
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=
POSTGRES_USER=newsuser
POSTGRES_PASSWORD=newspassword
POSTGRES_DB=newsdb
POSTGRES_PORT=5432

# ---------- Ports ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Monitoring ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PUBLIC_URL=http://localhost:3000
PROMETHEUS_PUBLIC_URL=http://localhost:9090
