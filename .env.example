# Application Configuration
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# Database Configuration (Supabase / PostgreSQL)
# Option A: Supabase Connection String (Direct or Session Pooler 5432 / Transaction Pooler 6543)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Option B: Standard Database URLs (auto-falls back to local PostgreSQL if Supabase is not provided)
POSTGRES_USER=newsuser
POSTGRES_PASSWORD=newspassword
POSTGRES_DB=newsdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://newsuser:newspassword@localhost:5432/newsdb
DATABASE_SYNC_URL=postgresql://newsuser:newspassword@localhost:5432/newsdb

# Collector Configuration
COLLECTION_INTERVAL_SECONDS=300
FEED_FETCH_TIMEOUT_SECONDS=15
MAX_ARTICLES_PER_FEED=25

# Redis Caching Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# External AI Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
